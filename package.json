{
  "name": "gtfs-zone-editor",
  "version": "0.0.0-development",
  "description": "A fast, simple editor for GTFS transit data - inspired by geojson.io",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "version": "tsx scripts/get-version.ts",
    "prebuild": "tsx scripts/get-version.ts > .version",
    "dev": "vite",
    "start": "vite",
    "serve": "vite preview --port 8080",
    "build": "vite build",
    "generate-favicons": "./scripts/generate-favicons.sh",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run check-spec",
    "check-spec": "tsx scripts/check-spec.ts",
    "knip": "knip",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "commit": "cz commit",
    "vuln": "sh scripts/vuln-gate.sh",
    "screenshots:feed": "tsx scripts/screenshots/build-demo-feed.ts && tsx scripts/screenshots/build-synthetic-feed.ts",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "keywords": [
    "gtfs",
    "transit",
    "editor",
    "transport",
    "map"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/clusterize.js": "^0.18.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "git-describe": "^4.1.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tailwindcss/postcss": "^4.3.3",
    "clusterize.js": "^1.0.0",
    "daisyui": "^5.7.46",
    "gtfs-zone-web-common": "github:gtfs-zone/gtfs-zone-web-common#v5.8.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11.2",
    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  }
}
